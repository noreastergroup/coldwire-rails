<%# Coldwire's debug surface. Styled with plain CSS on purpose: the gem must not assume
    Tailwind, Bootstrap, or any host framework. Override this template by creating
    app/views/coldwire/caches/show.html.erb in your own app. %>

<style>
  .coldwire { max-width: 42rem; margin: 0 auto; padding: 1rem; font-family: system-ui, -apple-system, sans-serif; color: #1f2937; }
  .coldwire h1 { font-size: 1.5rem; margin: 0 0 0.25rem; }
  .coldwire .coldwire-tagline { color: #6b7280; font-size: 0.875rem; margin: 0 0 1rem; }
  .coldwire-card { border: 1px solid #e5e7eb; border-radius: 1rem; background: #fff; padding: 1rem; margin-bottom: 0.75rem; }
  .coldwire-card h2 { font-size: 1rem; font-weight: 600; margin: 0 0 0.5rem; }
  .coldwire-row { display: flex; gap: 0.5rem; font-size: 0.875rem; color: #6b7280; }
  .coldwire-row dt { width: 6rem; flex-shrink: 0; color: #9ca3af; }
  .coldwire-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
  .coldwire-button { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    cursor: pointer; border: 1px solid #d1d5db; border-radius: 0.5rem; background: #fff; color: #111827;
    padding: 0.375rem 0.75rem; font-size: 0.875rem; font-weight: 600; line-height: 1.5rem; white-space: nowrap; }
  .coldwire-button[disabled] { opacity: 0.6; cursor: default; }
  .coldwire-spinner { width: 1rem; height: 1rem; flex-shrink: 0; border-radius: 9999px;
    border: 2px solid #d1d5db; border-top-color: #374151; animation: coldwire-spin 0.7s linear infinite; }
  @keyframes coldwire-spin { to { transform: rotate(360deg); } }
  .coldwire-track { height: 0.375rem; width: 100%; overflow: hidden; border-radius: 9999px; background: #e5e7eb; }
  .coldwire-bar { height: 100%; width: 100%; border-radius: 9999px; background: #374151; transition: width 200ms; }
  .coldwire-pulse { animation: coldwire-fade 1.4s ease-in-out infinite; }
  @keyframes coldwire-fade { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
  .coldwire-progress-label { margin-top: 0.375rem; font-size: 0.75rem; color: #6b7280; }
  .coldwire-entries { list-style: none; margin: 0.5rem 0 0; padding: 0; max-height: 16rem; overflow-y: auto; }
  .coldwire-entries li + li { margin-top: 0.5rem; }
  .coldwire-entry { min-width: 0; }
  .coldwire-entry-url { overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.75rem; color: #1f2937; }
  .coldwire-entry-meta { margin-top: 0.125rem; font-size: 0.75rem; color: #6b7280; }
  .coldwire-empty { color: #9ca3af; font-size: 0.875rem; }
  .coldwire-toggle { display: flex; gap: 0.75rem; align-items: flex-start; cursor: pointer; }
  .coldwire-status { padding: 0 0.25rem; font-size: 0.875rem; color: #6b7280; }
  @media (prefers-color-scheme: dark) {
    .coldwire { color: #e5e7eb; }
    .coldwire-card { background: #111827; border-color: #374151; }
    .coldwire-button { background: #1f2937; border-color: #4b5563; color: #f9fafb; }
    .coldwire-entry-url { color: #e5e7eb; }
    .coldwire-track { background: #374151; }
    .coldwire-bar { background: #9ca3af; }
  }
</style>

<div class="coldwire"
     data-controller="coldwire-cache"
     data-coldwire-cache-pack-url-value="<%= coldwire.pack_path %>">
  <h1>Coldwire</h1>
  <p class="coldwire-tagline">When your Hotwire wires go cold.</p>

  <div class="coldwire-card">
    <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem;">
      <div>
        <h2>Status</h2>
        <dl style="margin: 0;">
          <div class="coldwire-row">
            <dt>Network</dt>
            <dd data-coldwire-cache-target="connection" style="margin: 0;">Checking…</dd>
          </div>
          <div class="coldwire-row">
            <dt>Worker</dt>
            <dd data-coldwire-cache-target="worker" style="margin: 0;">Checking…</dd>
          </div>
          <div class="coldwire-row">
            <dt>Cache</dt>
            <dd data-coldwire-cache-target="summary" style="margin: 0;">Checking…</dd>
          </div>
        </dl>
      </div>
      <button type="button"
              class="coldwire-button"
              data-coldwire-cache-target="refreshButton"
              data-action="click->coldwire-cache#refresh">
        Refresh
      </button>
    </div>
  </div>

  <div class="coldwire-card">
    <label class="coldwire-toggle">
      <input type="checkbox"
             style="margin-top: 0.25rem;"
             data-coldwire-cache-target="forcedToggle"
             data-action="change->coldwire-cache#toggleForced">
      <span>
        <span style="display: block; font-weight: 600;">Force offline mode</span>
        <span style="display: block; margin-top: 0.125rem; font-size: 0.875rem; color: #6b7280;">
          Serve only cached pages even with a connection.
          Note the worker resets this if the browser shuts it down while idle — airplane mode is the trustworthy test.
        </span>
      </span>
    </label>
  </div>

  <div class="coldwire-card">
    <h2>Precache</h2>
    <p style="margin: 0.25rem 0 0; font-size: 0.875rem; color: #6b7280;">
      Fetch every URL in the manifest, plus the same-origin assets those pages reference.
    </p>

    <div class="coldwire-actions">
      <button type="button"
              class="coldwire-button"
              data-coldwire-cache-target="prefetchButton"
              data-action="click->coldwire-cache#prefetch">
        <span class="coldwire-spinner" data-coldwire-cache-target="spinner" aria-hidden="true" hidden></span>
        <span data-coldwire-cache-target="prefetchLabel">Precache</span>
      </button>
      <button type="button"
              class="coldwire-button"
              data-coldwire-cache-target="clearButton"
              data-action="click->coldwire-cache#clear">
        Clear cache
      </button>
    </div>

    <div style="margin-top: 0.75rem;"
         role="progressbar"
         aria-valuemin="0"
         aria-valuemax="100"
         data-coldwire-cache-target="progress"
         hidden>
      <div class="coldwire-track">
        <div class="coldwire-bar" data-coldwire-cache-target="progressBar"></div>
      </div>
      <div class="coldwire-progress-label" data-coldwire-cache-target="progressLabel"></div>
    </div>
  </div>

  <div class="coldwire-card">
    <h2>Cached URLs</h2>
    <ul class="coldwire-entries" data-coldwire-cache-target="entries">
      <li class="coldwire-empty">None yet.</li>
    </ul>
  </div>

  <p class="coldwire-status" data-coldwire-cache-target="status"></p>
</div>
