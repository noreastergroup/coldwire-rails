<%# Full-page offline fallback. Override by creating this same path in your own app. %>
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%# Served with a 200, so keep Turbo from snapshotting it and restoring it once back online. %>
    <meta name="turbo-cache-control" content="no-cache">
    <title>Offline</title>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem; color: #1f2937;">
    <h1 style="font-size: 1.5rem;">You're offline</h1>
    <p>This page hasn't been cached yet. Open it while online, then try again.</p>
  </body>
</html>
